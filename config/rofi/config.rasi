configuration {
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    display-drun: " ";
    display-run: " ";
    display-window: " ";
    drun-display-format: "{name}";
    modi: "window,run,drun";
}

* {
    bg: #1e1e2e;
    bg-alt: #313244;
    fg: #cdd6f4;
    fg-alt: #a6adc8;
    accent: #89b4fa;
    
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 450px;
    border: 2px solid;
    border-color: @accent;
    background-color: @bg;
    padding: 0px;
}

mainbox {
    spacing: 0px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 20px;
    background-color: transparent;
    border: 0 0 1px 0 solid;
    border-color: #45475a;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    padding: 0 15px 0 0;
    font: "JetBrainsMono Nerd Font 14";
    vertical-align: 0.5;
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg-alt;
    text-color: @fg;
    vertical-align: 0.5;
}

listview {
    columns: 1;
    lines: 13;
    padding: 10px;
    spacing: 4px;
    background-color: transparent;
    border: 0px;
    scrollbar: false;
}

element {
    padding: 12px;
    border-radius: 0px;
    background-color: transparent;
    text-color: @fg-alt;
}

element-icon {
    size: 24px;
    padding: 0 15px 0 0;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg-alt;
}

element selected.normal {
    background-color: @bg-alt;
    text-color: @accent;
}
